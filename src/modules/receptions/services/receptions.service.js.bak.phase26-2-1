import api from '@/shared/services/api'

function unwrapResponse(response) {
  return response?.data ?? response
}

function unwrapItem(response) {
  return response?.data?.data?.item || response?.data?.item || response?.data?.data || response?.data
}

function cleanParams(params = {}) {
  return Object.fromEntries(
    Object.entries(params).filter(([, value]) => value !== undefined && value !== null && value !== ''),
  )
}

export const receptionsService = {
  async list(params = {}) {
    const response = await api.get('/receptions', {
      params: cleanParams({
        page: params.page || 1,
        limit: params.limit || params.limite || 10,
        q: params.q,
        status: params.status,
        priority: params.priority,
        patientId: params.patientId,
        serviceId: params.serviceId,
      }),
    })

    return unwrapResponse(response)
  },

  async search(params = {}) {
    return this.list({
      page: 1,
      limit: params.limit || 20,
      q: params.q,
      status: params.status,
      priority: params.priority || params.urgence,
      serviceId: params.serviceId || params.service,
      patientId: params.patientId,
    })
  },

  async getById(id) {
    const response = await api.get(`/receptions/${id}`)
    return unwrapResponse(response)
  },

  async create(payload) {
    const response = await api.post('/receptions', payload)
    return unwrapItem(response)
  },

  async update(id, payload) {
    const response = await api.patch(`/receptions/${id}`, payload)
    return unwrapItem(response)
  },
}